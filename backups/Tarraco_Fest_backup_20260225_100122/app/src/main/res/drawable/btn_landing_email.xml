<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#66FFFFFF" />
            <stroke
                android:width="2dp"
                android:color="#80FFB477" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#FFF8EAD8" />
            <stroke
                android:width="2dp"
                android:color="#FF8A1A" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#FFFDF9F3" />
            <stroke
                android:width="2dp"
                android:color="#FF8A1A" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
