<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAdminPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_landing"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_landing_blur"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_bottom_scrim"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAdminPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        app:cardBackgroundColor="@color/landing_card_surface"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/dialog_glass_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.52">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_drawer_admin"
                app:tint="@color/festival_orange" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_glass_chip"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="@string/admin_panel_chip"
                android:textAllCaps="true"
                android:textColor="@color/dialog_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/admin_panel_title"
                android:textColor="@color/dialog_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/admin_panel_subtitle"
                android:textColor="@color/dialog_hint"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvAdminEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_estado_info"
                android:padding="10dp"
                android:text="@string/admin_checking_access"
                android:textColor="@color/dialog_text"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminUsuarios"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_auth_primary"
                android:text="@string/admin_panel_users"
                android:textAllCaps="false"
                android:textColor="@color/auth_btn_primary_text"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_person"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/auth_btn_primary_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminEventos"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_auth_secondary"
                android:text="@string/admin_panel_events"
                android:textAllCaps="false"
                android:textColor="@color/auth_btn_secondary_text"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_detail_calendar"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/auth_btn_secondary_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminVolver"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_auth_secondary"
                android:text="@string/admin_back"
                android:textAllCaps="false"
                android:textColor="@color/auth_btn_secondary_text"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_detail_back"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/auth_btn_secondary_text" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
