<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvGoogleAccountChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_chip"
            android:text="@string/auth_reset_chip"
            android:textAllCaps="true"
            android:textColor="@color/dialog_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_permission_icon">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_google_logo" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvGoogleAccountTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/auth_dialog_google_account_title"
            android:textColor="@color/dialog_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGoogleAccountMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/auth_dialog_google_account_message"
            android:textColor="@color/dialog_hint"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvGoogleAccountEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_dialog"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:textColor="@color/dialog_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGoogleAccountHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_dialog"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:text="@string/auth_account_exists_google_hint"
            android:textColor="@color/dialog_text"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogleAddPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/btn_auth_primary"
            android:text="@string/auth_dialog_add_password"
            android:textAllCaps="false"
            android:textColor="@color/auth_btn_primary_text"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:icon="@android:drawable/ic_lock_lock"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/auth_btn_primary_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogleContinue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_google_signin"
            android:text="@string/auth_dialog_signin_google"
            android:textAllCaps="false"
            android:textColor="#3C4043"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_google_logo"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="20dp"
            app:iconTint="@null" />

        <TextView
            android:id="@+id/tvGoogleCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="@string/detail_cancel"
            android:textColor="@color/dialog_hint"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
