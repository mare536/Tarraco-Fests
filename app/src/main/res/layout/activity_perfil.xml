<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerPerfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootPerfil"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imgBgNormal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_landing"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imgBgBlur"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_landing_blur"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            android:background="@drawable/bg_bottom_scrim"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/topBarPerfil"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_profile_topbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnMenuPerfil"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/profile_menu_open"
                android:padding="8dp"
                android:src="@drawable/ic_menu_hamburger"
                app:tint="@color/dialog_text" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/profile_toolbar_title"
                android:textColor="@color/dialog_text"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/perfilContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBarPerfil">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/landing_card_surface"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/dialog_glass_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_chip"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="@string/profile_chip"
                        android:textAllCaps="true"
                        android:textColor="@color/dialog_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTituloSeccionPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/profile_section_general"
                        android:textColor="@color/dialog_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSubtituloSeccionPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/profile_section_general_subtitle"
                        android:textColor="@color/dialog_hint"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvEstadoPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_estado_info"
                        android:padding="10dp"
                        android:textColor="@color/dialog_text"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/sectionInformacionPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_profile_section"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvInfoEmailPerfil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/dialog_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvInfoNombreEstadoPerfil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/dialog_text"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvInfoTelefonoEstadoPerfil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/dialog_text"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvInfoCiudadEstadoPerfil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/dialog_text"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvInfoBioEstadoPerfil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/dialog_text"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvInfoCuentaEstadoPerfil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/dialog_hint"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sectionSeguridadPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_profile_section"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvPasswordEstado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_password_help"
                            android:textColor="@color/dialog_hint"
                            android:textSize="13sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPass1Perfil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="@string/profile_password_new"
                            app:boxBackgroundColor="@color/dialog_input_bg"
                            app:boxBackgroundMode="filled"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxStrokeColor="@color/dialog_glass_stroke"
                            app:endIconMode="password_toggle">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPass1Perfil"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="newPassword"
                                android:inputType="textPassword"
                                android:padding="12dp"
                                android:textColor="@color/dialog_text"
                                android:textColorHint="@color/dialog_hint" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPass2Perfil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="@string/profile_password_repeat"
                            app:boxBackgroundColor="@color/dialog_input_bg"
                            app:boxBackgroundMode="filled"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxStrokeColor="@color/dialog_glass_stroke"
                            app:endIconMode="password_toggle">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPass2Perfil"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="newPassword"
                                android:inputType="textPassword"
                                android:padding="12dp"
                                android:textColor="@color/dialog_text"
                                android:textColorHint="@color/dialog_hint" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Button
                            android:id="@+id/btnVincularPassword"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/btn_auth_secondary"
                            android:text="@string/profile_add_password_button"
                            android:textAllCaps="false"
                            android:textColor="@color/auth_btn_secondary_text"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sectionEditarPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@android:color/transparent"
                        android:orientation="vertical"
                        android:padding="0dp"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/profile_name_label"
                            app:boxBackgroundColor="@color/dialog_input_bg"
                            app:boxBackgroundMode="filled"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxStrokeColor="@color/dialog_glass_stroke">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etNombrePerfil"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="personName"
                                android:inputType="textPersonName"
                                android:padding="12dp"
                                android:textColor="@color/dialog_text"
                                android:textColorHint="@color/dialog_hint" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="@string/profile_phone_label"
                            app:boxBackgroundColor="@color/dialog_input_bg"
                            app:boxBackgroundMode="filled"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxStrokeColor="@color/dialog_glass_stroke">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTelefonoPerfil"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="phone"
                                android:inputType="phone"
                                android:padding="12dp"
                                android:textColor="@color/dialog_text"
                                android:textColorHint="@color/dialog_hint" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="@string/profile_city_label"
                            app:boxBackgroundColor="@color/dialog_input_bg"
                            app:boxBackgroundMode="filled"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxStrokeColor="@color/dialog_glass_stroke">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCiudadPerfil"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="postalAddressLocality"
                                android:inputType="textCapWords"
                                android:padding="12dp"
                                android:textColor="@color/dialog_text"
                                android:textColorHint="@color/dialog_hint" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="@string/profile_bio_label"
                            app:boxBackgroundColor="@color/dialog_input_bg"
                            app:boxBackgroundMode="filled"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxStrokeColor="@color/dialog_glass_stroke">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etBioPerfil"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top|start"
                                android:inputType="textCapSentences|textMultiLine"
                                android:maxLines="3"
                                android:minLines="3"
                                android:padding="12dp"
                                android:textColor="@color/dialog_text"
                                android:textColorHint="@color/dialog_hint" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Button
                            android:id="@+id/btnGuardarPerfil"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/btn_auth_primary"
                            android:text="@string/profile_save_button"
                            android:textAllCaps="false"
                            android:textColor="@color/auth_btn_primary_text"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/loadingPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:indeterminate="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/profile_loading"
                            android:textColor="@color/dialog_text"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navPerfil"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/landing_card_surface"
        app:headerLayout="@layout/nav_header_perfil"
        app:itemBackground="@drawable/bg_drawer_item"
        app:itemIconTint="@color/drawer_item_icon"
        app:itemTextColor="@color/drawer_item_text"
        app:menu="@menu/menu_perfil_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
