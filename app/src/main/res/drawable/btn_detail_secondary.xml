<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/detail_action_secondary_bg_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/detail_action_secondary_stroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="@color/detail_action_secondary_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/detail_action_secondary_stroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
