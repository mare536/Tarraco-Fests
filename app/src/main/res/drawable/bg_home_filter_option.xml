<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/home_filter_option_checked_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/home_filter_option_checked_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/home_filter_option_checked_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/home_filter_option_checked_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/home_filter_option_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/home_filter_option_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
