<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/auth_btn_primary_bg_disabled" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/auth_btn_primary_bg_pressed" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="@color/auth_btn_primary_bg" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
